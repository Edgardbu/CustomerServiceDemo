APP_NAME=Omnichannel Backend
APP_ENV=local
API_PREFIX=/api/v1

DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnichannel
REALTIME_PROVIDER=memory
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

JWT_SECRET=change-me

# First-owner bootstrap (required for fresh installs)
BOOTSTRAP_ENABLED=true
BOOTSTRAP_SECRET=

# Optional: seed demo owner/agent when APP_ENV=local (off by default)
SEED_DEMO_USERS=false

# Instagram (graph.instagram.com) — profile, webhooks, outbound DMs
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional account ID used in POST /{id}/messages (e.g. 17841416293732352)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=change-me
INSTAGRAM_API_BASE_URL=https://graph.instagram.com
INSTAGRAM_API_VERSION=v25.0

# Optional alias; used as fallback if INSTAGRAM_ACCOUNT_ID is not set
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook Messenger (Meta Page — send, profile, webhooks)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# Webhook verify token for /webhooks/messenger (falls back to INSTAGRAM_VERIFY_TOKEN)
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me

# SMS (demo provider — logs sends, no external gateway)
SMS_PROVIDER=demo

# Email (SMTP outbound; inbound via demo endpoint for now)
EMAIL_PROVIDER=smtp_demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Support
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Omnichannel demo simulator (frontend testing without real providers)
DEMO_CHANNELS_ENABLED=true
DEMO_CHANNEL_SECRET=
